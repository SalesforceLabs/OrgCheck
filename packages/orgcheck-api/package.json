{
    "name": "@orgcheck/api",
    "version": "8.0.1",
    "license": "MIT",
    "private": false,
    "devDependencies": {
        "@babel/core": "^8.0.0",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.0",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.2.0",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@types/jest": "^30.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "babel-jest": "^30.2.0",
        "esbuild": "^0.25.0",
        "eslint": "^10.11.0",
        "fflate": "^0.8.2",
        "jest": "^30.2.0",
        "rollup": "^4.57.1",
        "rollup-plugin-dts": "^6.5.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "rollup-plugin-typescript2": "^0.37.0",
        "ts-jest": "^29.4.6",
        "tslib": "^2.8.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.56.0"
    },
    "scripts": {
        "verify": "yarn scan:lint && yarn scan:code-analyzer",
        "build": "yarn js:build && yarn pack",
        "test": "yarn test:unit",
        "deploy": "yarn npm:publish:api",
        "postpack": "mv orgcheck-api-*.tgz dist/",
        "scan:lint": "eslint",
        "scan:code-analyzer": "sf code-analyzer run --target ./src --output-file /tmp/orgcheck-api-scan.html; open /tmp/orgcheck-api-scan.html",
        "test:unit": "jest \".*unit.*\" ",
        "pack": "npm pack --ignore-scripts",
        "js:build": "rollup -c rollup.config.mjs && jest \".*bundled.*\" ",
        "npm:publish:api": "yarn version --pack && npm publish --access public --ignore-scripts"
    },
    "main": "./dist/orgcheck.js",
    "types": "./dist/orgcheck.d.ts",
    "files": [
        "dist"
    ],
    "dependencies": {
        "fflate": "^0.8.2",
        "jsforce": "^3.10.14",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    }
}
