{
  "name": "@orgcheck/sfdx-plugin",
  "description": "Org Check is an easy-to-install and easy-to-use Salesforce application in order to quickly analyze your org and its technical debt.",
  "version": "8.0.6",
  "private": false,
  "dependencies": {
    "@oclif/core": "^4",
    "@orgcheck/api": "^8.0.1",
    "@salesforce/core": "^9.0.0",
    "@salesforce/sf-plugins-core": "^13",
    "fflate": "^0.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/plugin-command-snapshot": "^5.2.3",
    "@salesforce/cli-plugins-testkit": "^5.3.20",
    "@salesforce/dev-scripts": "^13",
    "@types/jest": "^29.5.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-sf-plugin": "^1.18.8",
    "jest": "^30.4.2",
    "oclif": "^4.23.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/lib",
    "/messages",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "force",
    "salesforce",
    "salesforcedx",
    "sf",
    "sf-plugin",
    "sfdx",
    "sfdx-plugin"
  ],
  "license": "MIT",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topicSeparator": " ",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "flexibleTaxonomy": true
  },
  "scripts": {
    "verify": "yarn verify:lint",
    "build": "yarn build:clean && yarn build:compile",
    "test": "yarn test:compile && yarn test:nut",
    "deploy": "yarn deploy:npm:publish",

    "verify:lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --color --cache --cache-location .eslintcache --no-error-on-unmatched-pattern",
    
    "build:clean": "rm -rf lib tsconfig.tsbuildinfo && sf-clean all",
    "build:compile": "tsc -p tsconfig.json --pretty",
    
    "test:compile": "tsc -p \"./tests\" --pretty",
    "test:nut": "jest",
    
    "deploy:npm:publish": "yarn version --patch && yarn oclif manifest && npm pack --ignore-scripts && npm publish --access public --ignore-scripts",

    "docs": "sf-docs",
    "format": "prettier --write \"+(src|test|schemas)/**/*.+(ts|js|json)|command-snapshot.json\"",
    "link-check": "node -e \"process.exit(process.env.CI ? 0 : 1)\" || linkinator \"**/*.md\" --skip \"CHANGELOG.md|node_modules|tests/|confluence.internal.salesforce.com|my.salesforce.com|localhost|%s\" --markdown --retry --directory-listing --verbosity error",
    "postpack": "sf-clean --ignore-signing-artifacts",
    "prepack": "yarn build && oclif manifest",
    "version": "oclif readme"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": "./lib/index.js",
  "type": "module",
  "author": "Vincent FINET"
}
